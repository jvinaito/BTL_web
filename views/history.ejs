<% title = 'Lịch sử đơn hàng' %>

<div class="container py-5">
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <h2 class="fw-bold mb-4">Lịch sử</h2>

      <% if (orders.length === 0) { %>
        <p class="text-muted">Chưa có đơn hàng nào.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead class="table-light">
              <tr class="text-secondary small text-uppercase">
                <th class="border-0 py-3">Mã đơn hàng</th>
                <th class="border-0 py-3">Ngày</th>
                <th class="border-0 py-3">Tổng tiền</th>
                <th class="border-0 py-3 text-center">Trạng thái</th>
                <th class="border-0 py-3">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => { %>
              <tr>
                <td class="fw-bold"><%= order.orderId %></td>
                <td class="small"><%= formatDate(order.createdAt) %></td>
                <td class="fw-bold"><%= order.total.toLocaleString('vi-VN') %>đ</td>
                <td class="text-center">
                  <span class="badge rounded-pill 
                    <%= order.status === 'Complete' ? 'bg-success-subtle text-success' : 
                       order.status === 'Shipping' ? 'bg-info-subtle text-info' : 
                       order.status === 'Reject' ? 'bg-danger-subtle text-danger' : 
                       'bg-warning-subtle text-warning' %> px-3">
                    <%= ({ Pending: 'Chờ xử lý', Shipping: 'Đang giao', Complete: 'Hoàn thành', Reject: 'Đã từ chối' }[order.status] || order.status) %>
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <!-- Nút xem chi tiết -->
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#orderDetail<%= order._id %>">Xem</button>

                    <!-- Nút hủy đơn (chỉ hiện khi Pending) -->
                    <% if (order.status === 'Pending') { %>
                      <form action="/orders/cancel/<%= order._id %>?_method=PUT" method="POST" style="display:inline;" 
                            onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng <%= order.orderId %>?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal xem chi tiết đơn hàng (có thể lặp) -->
<% orders.forEach(order => { %>
<div class="modal fade" id="orderDetail<%= order._id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Đơn hàng <%= order.orderId %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p><strong>Ngày:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
        <p><strong>Trạng thái:</strong> <%= ({ Pending: 'Chờ xử lý', Shipping: 'Đang giao', Complete: 'Hoàn thành', Reject: 'Đã từ chối' }[order.status] || order.status) %></p>
        <p><strong>Giao đến:</strong>  <%= order.shippingAddress?.city %></p>
        <hr>
        <h6>Sản phẩm</h6>
        <ul class="list-group">
          <% order.products.forEach(item => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= item.product.name %> (x<%= item.quantity %>)
            <span><%= (item.price * item.quantity).toLocaleString('vi-VN') %>đ</span>
          </li>
          <% }) %>
        </ul>
        <hr>
        <p class="text-end fw-bold">Tổng tiền: <%= order.total.toLocaleString('vi-VN') %>đ</p>
      </div>
    </div>
  </div>
</div>
<% }) %>