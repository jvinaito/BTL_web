<% title = 'Trang chủ' %>

<section class="hero-section bg-light py-1">
  <div class="container">
    <div class="row align-items-center"> 
      <div class="col-md-6">
        <img src="https://i.ibb.co/j9VqSJfK/image.png" class="img-fluid" alt="ảnh giới thiệu">
      </div>
      <div class="col-md-6 text-center text-md-start">
        <h1 class="display-4 fw-bold text-info">Vui chơi, học hỏi và phát triển!</h1>
        <p class="lead text-muted">Mang đến nụ cười qua từng món đồ chơi, dành cho học tập, vui chơi và phát triển</p>
        <a href="/products" class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm">Mua ngay</a>
      </div>
    </div>
  </div>
</section>

<!-- Best Seller -->
<section class="py-5">
  <div class="container">
    <h2 class="text-center mb-4 fw-bold">Bán chạy nhất</h2>
    <div class="row g-3 row-cols-2 row-cols-md-4">
      <% bestSellers.forEach(product => { %>
        <div class="col">
          <div class="card h-100 border-light-subtle shadow-sm p-2 position-relative rounded-4 d-flex flex-column">
            <% if (product.discount > 0) { %>
              <span class="badge bg-danger position-absolute m-2 px-2" style="font-size:10px; z-index:1">GIẢM GIÁ</span>
            <% } %>
            <a href="/products/<%= product._id %>" class="text-decoration-none flex-grow-1 d-flex flex-column">
              <div style="height: 160px; display: flex; align-items: center; justify-content: center;">
                <img src="<%= product.imageUrl %>" class="p-2 rounded-4" style="max-height: 100%; max-width: 100%; object-fit: contain;">
              </div>
              <div class="card-body p-1 text-center d-flex flex-column flex-grow-1">
                <p class="small fw-bold mb-1 text-truncate text-dark"><%= product.name %></p>
                <div class="mb-2 mt-auto">
                  <span class="<%= product.discount > 0 ? 'text-success' : 'text-dark' %> fw-bold"><%= product.salePrice.toLocaleString('vi-VN') %>đ</span>
                  <% if (product.discount > 0) { %>
                    <small class="text-muted text-decoration-line-through ms-1"><%= product.originalPrice.toLocaleString('vi-VN') %>đ</small>
                  <% } %>
                </div>
              </div>
            </a>
            <button class="btn btn-info text-white rounded-pill py-2 w-100 fw-bold add-to-cart" data-id="<%= product._id %>">
              <i class="fa-solid fa-cart-shopping me-1"></i> Thêm vào giỏ
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

