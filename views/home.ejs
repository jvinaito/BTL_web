<!-- Recommended -->
<% if (recommended && recommended.length) { %>
<section class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center fw-bold glow-pink w-100 d-block">💡 Gợi ý cho bạn</h2>
    <div class="row g-3 row-cols-2 row-cols-md-4">
      <% recommended.forEach(product => { %>
        <div class="col">
          <div class="card h-100 border-light-subtle shadow-sm p-2 position-relative rounded-4 d-flex flex-column">
            <% if (product.discount > 0) { %><span class="product-badge badge-discount">-<%= product.discount %>%</span><% } %>
            <% if (product.sold > 50) { %><span class="product-badge badge-bestseller" style="left:10px; top:10px;">⭐ Bán chạy</span><% } %>
            <% if (product.isNew) { %><span class="product-badge badge-new" style="left:10px; top:50px;">🔥 Mới</span><% } %>

            <div class="compare-checkbox-wrapper position-absolute" style="bottom: 10px; right: 10px; z-index: 3;">
              <input type="checkbox" class="compare-checkbox form-check-input" value="<%= product._id %>" id="compare-<%= product._id %>" style="width: 20px; height: 20px; cursor: pointer;">
            </div>

            <a href="/products/<%= product._id %>" class="text-decoration-none flex-grow-1 d-flex flex-column">
