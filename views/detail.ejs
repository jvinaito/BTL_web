<% title = product.name %>

<div class="container py-5">
  <div class="row g-5 align-items-center">
    <div class="col-md-6 text-center">
      <div class="bg-white p-2 rounded-4">
        <img src="<%= product.imageUrl %>" class="img-fluid rounded-4" alt="<%= product.name %>">
      </div>
    </div>

    <div class="col-md-6">
      <h2 class="fw-bold display-6"><%= product.name %></h2>
      <h3 class="text-info fw-bold mb-3">$<%= product.salePrice %></h3>
      
      <div class="row g-3 mb-4">
        <div class="col-sm-6">
          <p class="mb-1"><strong>Category:</strong></p>
          <p class="text-muted"><%= product.category ? product.category.name : 'N/A' %></p>
        </div>
        <div class="col-sm-6">
          <p class="mb-1"><strong>Brand:</strong></p>
          <p class="text-muted">
            <% if (typeof product.brand === 'string') { %>
              <%= product.brand %>
            <% } else if (product.brand && product.brand.name) { %>
              <%= product.brand.name %>
            <% } else { %>
              N/A
            <% } %>
          </p>
        </div>
        <div class="col-sm-6">
          <p class="mb-1"><strong>Age Range:</strong></p>
          <p class="text-muted"><%= product.ageRange || 'N/A' %></p>
        </div>
        <div class="col-sm-6">
          <p class="mb-1"><strong>Gender:</strong></p>
          <p class="text-muted"><%= product.gender || 'Unisex' %></p>
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="input-group flex-nowrap shadow-sm rounded-pill overflow-hidden border" style="width: 130px;">
          <button class="btn btn-white border-0 px-3" onclick="updateQty(-1)">-</button>
          <input type="text" id="qty" class="form-control border-0 text-center bg-white fw-bold" value="1" readonly>
          <button class="btn btn-white border-0 px-3" onclick="updateQty(1)">+</button>
        </div>
        
        <button class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow-sm add-to-cart" data-id="<%= product._id %>" data-qty="1">
          <i class="fa-solid fa-cart-shopping me-2"></i> Thêm vào giỏ
        </button>
      </div>
    </div>
  </div>

  <!-- Mô tả chi tiết -->
  <div class="mt-5 border-0 shadow-sm rounded-4 bg-white p-4">
    <h5 class="fw-bold mb-3">Description</h5>
    <div class="text-muted">
      <p><%= product.description || 'No description available.' %></p>
    </div>
  </div>

  <!-- Related products -->
  <% if (related && related.length) { %>
  <div class="mt-5">
    <h3 class="fw-bold mb-4">Sản phẩm tương tự</h3>
    <div id="related-scroll" style="overflow-x: auto; cursor: grab; scroll-behavior: smooth;">
      <div class="d-flex gap-3 pb-2" style="width: max-content;">
        <% related.forEach(p => { %>
          <div style="width: 200px; flex-shrink: 0;">
            <div class="card h-100 border-light-subtle rounded-4 shadow-sm border-0 p-2 position-relative d-flex flex-column">
              <% if (p.discount > 0) { %>
                <span class="badge bg-danger position-absolute m-2 px-2" style="font-size:10px; z-index:1;">SALE</span>
              <% } %>
              <a href="/products/<%= p._id %>" class="text-decoration-none flex-grow-1 d-flex flex-column">
                <div style="height: 130px; display: flex; align-items: center; justify-content: center;">
                  <img src="<%= p.imageUrl %>" class="p-2 rounded-4" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                </div>
                <div class="card-body p-2 text-center d-flex flex-column flex-grow-1">
                  <h6 class="fw-bold mb-1 text-truncate text-dark"><%= p.name %></h6>
                  <div class="mb-2 mt-auto">
                    <span class="<%= p.discount > 0 ? 'text-success' : 'text-dark' %> fw-bold">$<%= p.salePrice %></span>
                    <% if (p.discount > 0) { %>
                      <small class="text-muted text-decoration-line-through ms-1">$<%= p.originalPrice %></small>
                    <% } %>
                  </div>
                </div>
              </a>
              <button class="btn btn-info text-white rounded-pill py-2 w-100 fw-bold add-to-cart" data-id="<%= p._id %>">
                <i class="fa-solid fa-cart-shopping me-1"></i> Thêm vào giỏ
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>

</div>

<script>
function updateQty(val) {
  const qty = document.getElementById('qty');
  const current = parseInt(qty.value);
  if (current + val >= 1) qty.value = current + val;
  // Sync qty to add-to-cart button
  document.querySelector('.add-to-cart[data-qty]').dataset.qty = qty.value;
}

// Horizontal scroll with drag support
const scrollContainer = document.getElementById('related-scroll');
if (scrollContainer) {
  let isDown = false;
  let startX, scrollLeft;

  scrollContainer.addEventListener('mousedown', (e) => {
    isDown = true;
    scrollContainer.style.cursor = 'grabbing';
    startX = e.pageX - scrollContainer.offsetLeft;
    scrollLeft = scrollContainer.scrollLeft;
  });
  scrollContainer.addEventListener('mouseleave', () => {
    isDown = false;
    scrollContainer.style.cursor = 'grab';
  });
  scrollContainer.addEventListener('mouseup', () => {
    isDown = false;
    scrollContainer.style.cursor = 'grab';
  });
  scrollContainer.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - scrollContainer.offsetLeft;
    scrollContainer.scrollLeft = scrollLeft - (x - startX) * 1.5;
  });
}
</script>
