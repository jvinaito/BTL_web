<% title = 'Quản lý đơn hàng' %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="d-flex align-items-center gap-3">
    <span class="fw-bold">Tất cả đơn hàng (<%= orders.length %>)</span>
  </div>
  <div class="d-flex gap-3 align-items-center">
    <!-- Form tìm kiếm -->
    <form method="GET" action="/admin/orders" class="d-flex gap-2">
      <div class="input-group input-group-sm" style="width: 250px;">
        <input type="text" name="search" class="form-control border-end-0 shadow-none" placeholder="Tìm theo mã đơn hàng, khách hàng..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button class="btn btn-light border-start-0" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>
    <!-- Bộ lọc trạng thái -->
    <select class="form-select form-select-sm" style="width: 150px;" onchange="location = this.value;">
      <option value="/admin/orders?status=all" <%= (!status || status === 'all') ? 'selected' : '' %>>Tất cả trạng thái</option>
      <option value="/admin/orders?status=Pending" <%= status === 'Pending' ? 'selected' : '' %>>Chờ xử lý</option>
      <option value="/admin/orders?status=Shipping" <%= status === 'Shipping' ? 'selected' : '' %>>Đang giao</option>
      <option value="/admin/orders?status=Complete" <%= status === 'Complete' ? 'selected' : '' %>>Hoàn thành</option>
      <option value="/admin/orders?status=Reject" <%= status === 'Reject' ? 'selected' : '' %>>Đã từ chối</option>
    </select>
    <i class="fa-solid fa-filter"></i>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr class="text-muted small border-bottom">
        <th class="fw-normal py-3">Mã đơn hàng</th>
        <th class="fw-normal">Khách hàng</th>
        <th class="fw-normal">Ngày</th>
        <th class="fw-normal">Tổng tiền</th>
        <th class="fw-normal">Trạng thái</th>
        <th class="fw-normal text-center">Thao tác</th>
      </tr>
    </thead>
    <tbody class="small">
      <% orders.forEach(order => { %>
      <tr>
        <td class="fw-bold"><%= order.orderId %></td>
        <td><%= order.user ? order.user.firstName + ' ' + order.user.lastName : 'Không có' %></td>
        <td><%= formatDate(order.createdAt) %></td>
        <td><%= order.total.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></td>
        <td>
          <span class="badge rounded-pill 
            <%= order.status === 'Complete' ? 'bg-success-subtle text-success' : 
               order.status === 'Shipping' ? 'bg-info-subtle text-info' : 
               order.status === 'Reject' ? 'bg-danger-subtle text-danger' : 
               'bg-warning-subtle text-warning' %> px-3">
            <%= ({ Pending: 'Chờ xử lý', Shipping: 'Đang giao', Complete: 'Hoàn thành', Reject: 'Đã từ chối' }[order.status] || order.status) %>
          </span>
        </td>
        <td class="text-center">
          <div class="d-flex gap-2 justify-content-center">
            <!-- Nút xem chi tiết -->
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#orderDetailModal<%= order._id %>">
              <i class="fa-solid fa-eye"></i>
            </button>
            <!-- Dropdown cập nhật trạng thái -->
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport">
                <i class="fa-solid fa-gear"></i>
              </button>
              <ul class="dropdown-menu">
                <% if (order.status === 'Pending') { %>
                  <li>
                    <form action="/admin/orders/<%= order._id %>?_method=PUT" method="POST">
                      <input type="hidden" name="status" value="Shipping">
                      <button type="submit" class="dropdown-item">Đang giao</button>
                    </form>
                  </li>
                  <li>
                    <form action="/admin/orders/<%= order._id %>?_method=PUT" method="POST">
                      <input type="hidden" name="status" value="Reject">
                      <button type="submit" class="dropdown-item">Đã từ chối</button>
                    </form>
                  </li>
                <% } else if (order.status === 'Shipping') { %>
                  <li>
                    <form action="/admin/orders/<%= order._id %>?_method=PUT" method="POST">
                      <input type="hidden" name="status" value="Complete">
                      <button type="submit" class="dropdown-item">Hoàn thành</button>
                    </form>
                  </li>
                <% } else { %>
                  <li><span class="dropdown-item-text text-muted">Không có thao tác</span></li>
                <% } %>
              </ul>
            </div>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if (orders.length === 0) { %>
      <tr>
        <td colspan="6" class="text-center py-4">Không tìm thấy đơn hàng nào.</td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Modals chi tiết đơn hàng -->
<% orders.forEach(order => { %>
<div class="modal fade" id="orderDetailModal<%= order._id %>" tabindex="-1" aria-labelledby="orderDetailModalLabel<%= order._id %>" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="orderDetailModalLabel<%= order._id %>">Chi tiết đơn hàng - <%= order.orderId %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>Khách hàng:</strong> <%= order.user ? order.user.firstName + ' ' + order.user.lastName : 'Không có' %></p>
            <p><strong>Email:</strong> <%= order.user ? order.user.email : 'Không có' %></p>
            <p><strong>Số điện thoại:</strong> <%= order.shippingAddress ? order.shippingAddress.phone : 'Không có' %></p>
          </div>
          <div class="col-md-6">
            <p><strong>Ngày đặt:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
            <p><strong>Trạng thái:</strong> 
              <span class="badge 
                <%= order.status === 'Complete' ? 'bg-success' : 
                   order.status === 'Shipping' ? 'bg-info' : 
                   order.status === 'Reject' ? 'bg-danger' : 
                   'bg-warning' %>">
                <%= ({ Pending: 'Chờ xử lý', Shipping: 'Đang giao', Complete: 'Hoàn thành', Reject: 'Đã từ chối' }[order.status] || order.status) %>
              </span>
            </p>
            <p><strong>Địa chỉ giao hàng:</strong> <%= order.shippingAddress ? order.shippingAddress.city : 'Không có' %></p>
          </div>
        </div>
        <h6 class="fw-bold mb-3">Sản phẩm</h6>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Sản phẩm</th>
              <th>Giá</th>
              <th>Số lượng</th>
              <th>Tạm tính</th>
            </tr>
          </thead>
          <tbody>
            <% order.products.forEach(item => { %>
            <tr>
              <td><%= item.product ? item.product.name : 'Không xác định' %></td>
              <td><%= item.price.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></td>
              <td><%= item.quantity %></td>
              <td><%= (item.price * item.quantity).toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="3" class="text-end">Tổng tiền:</th>
              <th><%= order.total.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>
<% }) %>