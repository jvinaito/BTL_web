<% title = 'Quản lý người dùng' %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="d-flex align-items-center gap-3">
    <span class="fw-bold">Tất cả người dùng (<%= totalUsers %>)</span>
    <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addUserModal">
      THÊM MỚI +
    </button>
  </div>
  <div class="d-flex gap-3 align-items-center">
    <!-- Form tìm kiếm -->
    <form method="GET" action="/admin/users" class="d-flex gap-2">
      <div class="input-group input-group-sm" style="width: 250px;">
        <input type="text" name="search" class="form-control border-end-0 shadow-none" placeholder="Tìm theo tên, email, số điện thoại..." value="<%= search %>">
        <button class="btn btn-light border-start-0" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>
    <!-- Bộ lọc level -->
 <!-- Bộ lọc level -->
<select class="form-select form-select-sm" style="width: 150px;" onchange="location = this.value;">
  <option value="/admin/users?level=all&search=<%= encodeURIComponent(search) %>" <%= level === 'all' ? 'selected' : '' %>>Tất cả cấp độ</option>
  <option value="/admin/users?level=Admin&search=<%= encodeURIComponent(search) %>" <%= level === 'Admin' ? 'selected' : '' %>>Quản trị viên</option>
  <option value="/admin/users?level=Vip&search=<%= encodeURIComponent(search) %>" <%= level === 'Vip' ? 'selected' : '' %>>VIP</option>
  <option value="/admin/users?level=Normal&search=<%= encodeURIComponent(search) %>" <%= level === 'Normal' ? 'selected' : '' %>>Thường</option>
</select>

<!-- Thêm dropdown sắp xếp amount -->
<select class="form-select form-select-sm" style="width: 180px;" onchange="location = this.value;">
  <option value="/admin/users?sort=amount_desc&level=<%= level %>&search=<%= encodeURIComponent(search) %>" <%= sort === 'amount_desc' ? 'selected' : '' %>>Số tiền (cao → thấp)</option>
  <option value="/admin/users?sort=amount_asc&level=<%= level %>&search=<%= encodeURIComponent(search) %>" <%= sort === 'amount_asc' ? 'selected' : '' %>>Số tiền (thấp → cao)</option>
  <option value="/admin/users?sort=date_desc&level=<%= level %>&search=<%= encodeURIComponent(search) %>" <%= sort === 'date_desc' ? 'selected' : '' %>>Ngày (mới nhất)</option>
</select>
    <i class="fa-solid fa-filter"></i>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr class="text-muted small border-bottom">
        <th class="fw-normal py-3">Ảnh</th>
        <th class="fw-normal">Tên</th>
        <th class="fw-normal">Ngày</th>
        <th class="fw-normal">Số điện thoại</th>
        <th class="fw-normal">Email</th>
        <th class="fw-normal">Cấp độ</th>
        <th class="fw-normal text-end">Số tiền</th>
        <th class="fw-normal text-center">Thao tác</th>
       </tr>
    </thead>
    <tbody class="small">
      <% users.forEach(user => { %>
      <tr>
        <td><img src="https://i.pravatar.cc/150?u=<%= user._id %>" class="rounded-circle shadow-sm" width="35" height="35"></td>
        <td><%= user.firstName %> <%= user.lastName %></td>
        <td><%= formatDate(user.createdAt) %></td>
        <td><%= user.phone || '—' %></td>
        <td><%= user.email %></td>
        <td>
          <span class="badge rounded-pill 
            <%= user.level === 'Admin' ? 'bg-success' : user.level === 'Vip' ? 'bg-warning text-dark' : 'bg-info' %> px-3">
            <%= ({ Admin: 'Quản trị viên', Vip: 'VIP', Normal: 'Thường' }[user.level] || user.level) %>
          </span>
        </td>
        <td class="text-end fw-bold"><%= user.totalSpent.toLocaleString('vi-VN') %>đ</td>
        <td class="text-center">
          <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editUserModal<%= user._id %>">
              <i class="fa-solid fa-pen"></i>
            </button>
            <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa người dùng này?')">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if (users.length === 0) { %>
      <tr>
        <td colspan="8" class="text-center py-4">Không tìm thấy người dùng nào.</td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>


<i class="fa-solid fa-filter"></i>
<!-- Phân trang (giữ nguyên) -->
<% if (totalPages > 1) { %>
<div class="d-flex justify-content-center mt-4">
  <nav>
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= level && level !== 'all' ? '&level=' + encodeURIComponent(level) : '' %>">
          <i class="fa-solid fa-chevron-left"></i>
        </a>
      </li>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= level && level !== 'all' ? '&level=' + encodeURIComponent(level) : '' %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= level && level !== 'all' ? '&level=' + encodeURIComponent(level) : '' %>">
          <i class="fa-solid fa-chevron-right"></i>
        </a>
      </li>
    </ul>
  </nav>
</div>
<% } %>

<!-- Modal thêm user -->
<div class="modal fade" id="addUserModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Thêm người dùng mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/users" method="POST">
          <div class="mb-3">
            <label class="form-label">Tên</label>
            <input type="text" name="firstName" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Họ</label>
            <input type="text" name="lastName" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input type="text" name="phone" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Cấp độ</label>
            <select name="level" class="form-control">
              <option value="Normal">Thường</option>
              <option value="Vip">VIP</option>
              <option value="Admin">Quản trị viên</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Tạo mới</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modals sửa user cho từng user -->
<% users.forEach(user => { %>
<div class="modal fade" id="editUserModal<%= user._id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Sửa người dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/users/<%= user._id %>?_method=PUT" method="POST">
          <div class="mb-3">
            <label class="form-label">Tên</label>
            <input type="text" name="firstName" class="form-control" value="<%= user.firstName %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Họ</label>
            <input type="text" name="lastName" class="form-control" value="<%= user.lastName %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="<%= user.email %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu mới (để trống nếu muốn giữ mật khẩu hiện tại)</label>
            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu mới">
          </div>
          <div class="mb-3">
            <label class="form-label">Cấp độ</label>
            <select name="level" class="form-control">
              <option value="Normal" <%= user.level === 'Normal' ? 'selected' : '' %>>Thường</option>
              <option value="Vip" <%= user.level === 'Vip' ? 'selected' : '' %>>VIP</option>
              <option value="Admin" <%= user.level === 'Admin' ? 'selected' : '' %>>Quản trị viên</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Cập nhật</button>
        </form>
      </div>
    </div>
  </div>
</div>
<% }) %>