<% title = 'Manage Categories' %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold">Categories</h4>
  <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
    ADD NEW +
  </button>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr class="text-muted small border-bottom">
        <th class="fw-normal py-3">Name</th>
        <th class="fw-normal">Created At</th>
        <th class="fw-normal text-center">Số lượng sản phẩm</th>
        <th class="fw-normal text-center">Actions</th>
      </tr>
    </thead>
    <tbody class="small">
      <% categories.forEach(cat => { %>
      <tr>
        <td><%= cat.name %></td>
        <td><%= formatDate(cat.createdAt) %></td>
        <td class="text-center"><%= cat.productCount %></td>
        <td class="text-center">
          <div class="d-flex gap-2 justify-content-center">
            <!-- Nút sửa -->
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editCategoryModal<%= cat._id %>">
              <i class="fa-solid fa-pen"></i>
            </button>
            <!-- Nút xóa -->
            <form action="/admin/categories/<%= cat._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this category?')">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if (categories.length === 0) { %>
      <tr>
        <td colspan="4" class="text-center py-4">No categories found.</td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Modal thêm category -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/categories" method="POST">
          <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary">Create</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modals sửa category -->
<% categories.forEach(cat => { %>
<div class="modal fade" id="editCategoryModal<%= cat._id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/categories/<%= cat._id %>?_method=PUT" method="POST">
          <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input type="text" name="name" class="form-control" value="<%= cat.name %>" required>
          </div>
          <button type="submit" class="btn btn-primary">Update</button>
        </form>
      </div>
    </div>
  </div>
</div>
<% }) %>