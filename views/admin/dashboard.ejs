<% title = 'Bảng điều khiển' %>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="p-4 rounded-4 shadow-sm border-0" style="background-color: #f0f4ff;">
      <p class="text-muted small mb-1 fw-bold text-uppercase">Người dùng</p>
      <h2 class="fw-bold mb-0"><%= totalUsers %></h2>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-4 rounded-4 shadow-sm border-0" style="background-color: #fff0f6;">
      <p class="text-muted small mb-1 fw-bold text-uppercase">Đơn hàng</p>
      <h2 class="fw-bold mb-0"><%= totalOrders %></h2>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-4 rounded-4 shadow-sm border-0" style="background-color: #f0fff4;">
      <p class="text-muted small mb-1 fw-bold text-uppercase">Kho</p>
      <h2 class="fw-bold mb-0"><%= totalProducts %></h2>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-4 rounded-4 shadow-sm border-0" style="background-color: #fff9f0;">
      <p class="text-muted small mb-1 fw-bold text-uppercase">Doanh thu</p>
      <h2 class="fw-bold mb-0"><%= totalIncome.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></h2>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Cột trái: New Users -->
  <div class="col-md-8">
    <div class="bg-white p-4 rounded-5 shadow-sm h-100">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0 text-info">Khách hàng nổi bật - <%= new Date().toLocaleString('vi-VN', { month: 'long', year: 'numeric' }) %></h5>
        <a href="/admin/users" class="btn btn-light btn-sm">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-borderless align-middle">
          <thead>
            <tr class="text-muted small border-bottom">
              <th class="pb-3 fw-normal">Người dùng</th>
              <th class="pb-3 fw-normal">Ngày</th>
              <th class="pb-3 fw-normal text-end">Số tiền</th>
            </tr>
          </thead>
          <tbody class="small">
            <% recentUsers.forEach(user => { %>
            <tr class="border-bottom border-light">
              <td class="py-3">
                <div class="d-flex align-items-center gap-2">
                  <img src="https://i.pravatar.cc/150?u=<%= user._id %>" class="rounded-circle" width="30">
                  <span><%= user.firstName %> <%= user.lastName %></span>
                </div>
              </td>
              <td class="text-muted"><%= formatDate(user.createdAt) %></td>
              <td class="text-end fw-bold"><%= user.totalSpent.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %></td>
            </tr>
            <% }) %>
            <% if (recentUsers.length === 0) { %>
            <tr>
              <td colspan="3" class="text-center py-4">Chưa có người dùng mới</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Cột phải: Best Sellers và New Arrivals -->
  <div class="col-md-4">
    <h6 class="fw-bold mb-4">Bán chạy nhất</h6>
    <div class="table-responsive">
      <table class="table table-sm table-borderless align-middle">
        <thead>
          <tr class="text-muted small">
            <th style="width: 40px;">Ảnh</th>
            <th>Tên sản phẩm</th>
            <th class="text-end">Đã bán</th>
          </tr>
        </thead>
        <tbody>
          <% bestSellers.forEach(product => { %>
          <tr>
            <td><img src="<%= product.imageUrl %>" style="width: 35px; height: 35px; object-fit: cover;" class="rounded-3"></td>
            <td class="fw-bold"><%= product.name %></td>
            <td class="text-end"><%= product.sold %></td>
          </tr>
          <% }) %>
          <% if (bestSellers.length === 0) { %>
          <tr><td colspan="3" class="text-muted small">Chưa có dữ liệu</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="bg-white p-4 rounded-5 shadow-sm">
      <h6 class="fw-bold mb-4">Sản phẩm mới</h6>
      <div class="d-flex flex-column gap-3">
        <% newArrivals.forEach(product => { %>
        <div class="d-flex align-items-center gap-3">
          <img src="<%= product.imageUrl %>" class="rounded-3 bg-light" width="45" height="45" style="object-fit: cover;">
          <div class="small">
            <div class="fw-bold"><%= product.name %></div>
            <div class="text-muted" style="font-size: 11px;">Đã thêm <%= formatDate(product.createdAt) %></div>
          </div>
        </div>
        <% }) %>
        <% if (newArrivals.length === 0) { %>
        <p class="text-muted small">Chưa có sản phẩm mới</p>
        <% } %>
      </div>
    </div>
  </div>
</div>