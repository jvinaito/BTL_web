<% title='Đăng nhập' %>

  <div class="container-fluid p-0">
    <div class="row g-0 min-vh-100">
      <div class="col-lg-5 d-flex flex-column justify-content-center px-5 py-4">
        <a class="navbar-brand d-flex align-items-center fw-bold cursor-pointer mb-5" href="/"
          style="font-family: 'Luckiest Guy', cursive; font-size: 2.2rem; letter-spacing: 2px;">
          <span class="text-primary">T</span>
          <span class="text-danger">O</span>
          <span class="text-warning">Y</span>
          <span class="text-success">S</span>
        </a>

        <div class="mb-3">
          <a href="javascript:history.back()" class="text-decoration-none text-info fw-bold">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
          </a>
        </div>

        <div class="mx-auto mx-lg-0" style="max-width: 400px; width: 100%;">
          <h2 class="fw-bold mb-1">Đăng nhập</h2>
          <p class="text-secondary small mb-4">Đăng nhập để truy cập tài khoản của bạn</p>

          <form method="POST" action="/auth/login">
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Email</label>
              <input type="email" name="email" class="form-control py-2 shadow-none" placeholder="john.doe@gmail.com"
                required>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Mật khẩu</label>
              <div class="input-group">
                <input type="password" name="password" class="form-control py-2 shadow-none border-end-0" required>
                <span class="input-group-text bg-white border-start-0 text-muted">
                  <i class="fa-regular fa-eye-slash toggle-password"></i>
                </span>
              </div>
            </div>



            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mb-3" id="login-btn"
              style="background-color: #3f51b5; border: none;">
              <span id="login-text">Đăng nhập</span>
              <span id="login-spinner" class="spinner-border spinner-border-sm d-none" role="status"
                aria-hidden="true"></span>
            </button>

            <p class="text-center small mb-4">Chưa có tài khoản? <a href="/auth/signup"
                class="text-info text-decoration-none fw-bold">Đăng ký</a></p>
          </form>
        </div>
      </div>

      <div class="col-lg-7 d-none d-lg-block">
        <img src="https://i.ibb.co/zH2NWrtL/image.png" class="w-100 vh-100 object-fit-cover" alt="Em bé">
      </div>
    </div>
  </div>
  <script>
    document.getElementById('login-form')?.addEventListener('submit', function(e) {
        const btn = document.getElementById('login-btn');
        const text = document.getElementById('login-text');
        const spinner = document.getElementById('login-spinner');
        if (btn) {
            text.classList.add('d-none');
            spinner.classList.remove('d-none');
            btn.disabled = true;
        }
    });
</script>